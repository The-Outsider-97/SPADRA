  "rules": [
    {
      "id": "nl.bbl.4.180.1.clear_width",
      "title": "Vrije breedte van een doorgang",
      "citation": {
        "instrument": "Bbl",
        "article": "4.180",
        "lid": "1",
        "table": "4.179"
      },
      "applies_to": {
        "category": "door"
      },
      "scope_when": {
        "op": "eq",
        "a": {
          "op": "fact",
          "name": "project.status"
        },
        "b": {
          "op": "const",
          "value": "new_build"
        }
      },
      "scope_note": "The installed dataset covers new construction (Bbl hoofdstuk 4) only; set the project status to New build to evaluate.",
      "applies_when": {
        "op": "table_has",
        "table": "4.179",
        "row": {
          "op": "fact",
          "name": "building.function"
        }
      },
      "applies_note": "Table 4.179 designates no rule for this building function.",
      "check": {
        "kind": "minimum",
        "value": {
          "op": "fact",
          "name": "door.clear_width_m"
        },
        "limit": {
          "op": "const",
          "value": 0.85
        },
        "unit": "m"
      },
      "assumptions": [
        "Art. 4.180 lid 1 covers a doorway to a verblijfsgebied, verblijfsruimte, toiletruimte, badruimte, bergruimte, buitenruimte or the space for reaching a lift, and a doorway on the route to them from the adjoining site. SPADRA screens every door in the project; confirm that each flagged door is such a doorway."
      ],
      "corrections": [
        {
          "id": "widen_opening",
          "label": "Widen the door opening",
          "key": "width",
          "unit": "m",
          "for": [
            "non_compliant"
          ],
          "new_value": {
            "op": "ceil_to",
            "value": {
              "op": "add",
              "args": [
                {
                  "op": "const",
                  "value": 0.85
                },
                {
                  "op": "mul",
                  "args": [
                    {
                      "op": "const",
                      "value": 2
                    },
                    {
                      "op": "fact",
                      "name": "door.frame_inset_m"
                    }
                  ]
                }
              ]
            },
            "step": 0.01
          },
          "side_effects": "The opening is widened about its centre line; the wall, any adjacent door or window and the room layout may need to change."
        }
      ],
      "review": {
        "status": "transcribed",
        "note": "Transcribed from two secondary web publications of the consolidated text; not yet checked against the official XML."
      }
    },
    {
      "id": "nl.bbl.4.180.1.clear_height",
