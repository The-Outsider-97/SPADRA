      "applies_note": "Table 4.179 designates no rule for this building function.",
      "check": {
        "kind": "minimum",
        "value": {
          "op": "fact",
          "name": "door.clear_height_m"
        },
        "limit": {
          "op": "table",
          "table": "4.179",
          "row": {
            "op": "fact",
            "name": "building.function"
          },
          "column": "free_height_m"
        },
        "unit": "m"
      },
      "assumptions": [
        "Art. 4.180 lid 1 covers a doorway to a verblijfsgebied, verblijfsruimte, toiletruimte, badruimte, bergruimte, buitenruimte or the space for reaching a lift, and a doorway on the route to them from the adjoining site. SPADRA screens every door in the project; confirm that each flagged door is such a doorway."
      ],
      "corrections": [
        {
          "id": "raise_opening",
          "label": "Raise the door opening",
          "key": "height",
          "unit": "m",
          "for": [
            "non_compliant"
          ],
          "new_value": {
            "op": "ceil_to",
            "value": {
              "op": "add",
              "args": [
                {
                  "op": "table",
                  "table": "4.179",
                  "row": {
                    "op": "fact",
                    "name": "building.function"
                  },
                  "column": "free_height_m"
                },
                {
                  "op": "fact",
                  "name": "door.frame_inset_m"
                }
              ]
            },
            "step": 0.01
          },
          "side_effects": "The door head moves up; it must still fit under the ceiling, a lintel or a floor above."
        }
      ],
      "review": {
        "status": "transcribed",
